From 7cb65cbe357e14dab89b746ea92ec4a924ac7159 Mon Sep 17 00:00:00 2001
From: Kiyanoush BAYAR <kiyanoushbayar@gmail.com>
Date: Fri, 20 Nov 2026 13:42:18 +0300
Subject: [PATCH 2/2] SystemUI: add config to hide the status bar window

config_hideStatusBarWindow (default false) makes the status bar window
invisible and untouchable and makes it provide no insets. The status bar
height and the privacy dot windows are unchanged, so camera and
microphone dots still appear.

Change-Id: I083309416b8e6b92928c54467a9d03291174b6ad
---
 packages/SystemUI/res/values/config.xml               |  2 ++
 .../window/StatusBarWindowControllerImpl.java         | 11 ++++++++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/res/values/config.xml b/packages/SystemUI/res/values/config.xml
index 140bb805a..3b2e850e2 100644
--- a/packages/SystemUI/res/values/config.xml
+++ b/packages/SystemUI/res/values/config.xml
@@ -384,6 +384,8 @@
     </string-array>
 
     <!-- Nav bar button default ordering/layout -->
+    <bool name="config_hideStatusBarWindow">false</bool>
+
     <string name="config_navBarLayout" translatable="false">left[.5W],back[1WC];home;recent[1WC],right[.5W]</string>
     <string name="config_navBarLayoutQuickstep" translatable="false">back[1.7WC];home;contextual[1.7WC]</string>
     <string name="config_navBarLayoutHandle" translatable="false">back[70AC];home_handle;ime_switcher[70AC]</string>
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/window/StatusBarWindowControllerImpl.java b/packages/SystemUI/src/com/android/systemui/statusbar/window/StatusBarWindowControllerImpl.java
index c4cadbad2..b3ec9a576 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/window/StatusBarWindowControllerImpl.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/window/StatusBarWindowControllerImpl.java
@@ -95,6 +95,7 @@ public class StatusBarWindowControllerImpl implements StatusBarWindowController
     private WindowManager.LayoutParams mLp;
     private final WindowManager.LayoutParams mLpChanged;
     private final Binder mInsetsSourceOwner = new Binder();
+    private final boolean mHidden;
 
     private final ConfigurationController.ConfigurationListener mConfigurationListener =
             new ConfigurationController.ConfigurationListener() {
@@ -117,6 +118,7 @@ public class StatusBarWindowControllerImpl implements StatusBarWindowController
             @Assisted int displayId,
             MultiDisplayStatusBarLogger multiDisplayLogger) {
         mContext = context;
+        mHidden = context.getResources().getBoolean(R.bool.config_hideStatusBarWindow);
         mDisplayId = displayId;
         mWindowManager = windowManager;
         mStatusBarConfigurationController = statusBarConfigurationController;
@@ -125,6 +127,9 @@ public class StatusBarWindowControllerImpl implements StatusBarWindowController
         mLogBuffer = logBuffer;
         mMultiDisplayLogger = multiDisplayLogger;
         mStatusBarWindowView = statusBarWindowViewInflater.inflate(context);
+        if (mHidden) {
+            mStatusBarWindowView.setVisibility(View.INVISIBLE);
+        }
         mLaunchAnimationContainer = mStatusBarWindowView.findViewById(
                 R.id.status_bar_launch_animation_container);
         mLpChanged = new WindowManager.LayoutParams();
@@ -265,7 +270,8 @@ public class StatusBarWindowControllerImpl implements StatusBarWindowController
                 height,
                 WindowManager.LayoutParams.TYPE_STATUS_BAR,
                 WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
-                        | WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS,
+                        | WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS
+                        | (mHidden ? WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE : 0),
                 PixelFormat.TRANSLUCENT);
         lp.privateFlags |= PRIVATE_FLAG_COLOR_SPACE_AGNOSTIC;
         lp.token = new Binder();
@@ -399,6 +405,9 @@ public class StatusBarWindowControllerImpl implements StatusBarWindowController
      * re-drawing this window and other windows. This method provides the correct insets.
      */
     private Insets getInsets(int height) {
+        if (mHidden) {
+            return Insets.NONE;
+        }
         return Insets.of(0, height, 0, 0);
     }
 
-- 
